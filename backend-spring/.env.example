APP_NAME=factory-guard-api
APP_ENV=local
APP_PORT=8080

DB_HOST=localhost
DB_PORT=3307
DB_NAME=industrial_ai
DB_USER=industrial_user
DB_PASSWORD=change_me_user_password

# Local application access values. Use service names such as redis/minio/chromadb only inside Docker networks.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_INSPECTION_ARTIFACTS=inspection-artifacts
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_MODELS=models
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKETS=true

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_DOCUMENTS=industrial_document_chunks
AI_SERVER_BASE_URL=http://localhost:8001
AI_SERVER_STATUS_PATH=/ai/v1/internal/system-status
AI_SERVER_STATUS_TIMEOUT_SEC=3
OPERATION_MONITORING_COLLECT_INTERVAL_MS=30000
OPERATION_MONITORING_REDIS_TTL_SECONDS=60
SPRING_INSTANCE_ID=spring-local-1

DOCUMENT_UPLOAD_MAX_SIZE_BYTES=52428800
DOCUMENT_UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,md
DOCUMENT_UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown,text/plain
DOCUMENT_UPLOAD_OBJECT_PREFIX=documents

JWT_SECRET=change_me_jwt_secret
JWT_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
