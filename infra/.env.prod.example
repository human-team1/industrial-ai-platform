# =============================================================================
# 운영 fullstack Docker Compose — 환경 변수 예시 (.env.prod 로 복사 후 값 입력)
#
# 커밋: 이 예시 파일만 버전관리함. 비밀이 들어간 .env.prod 는 절대 커밋하지 않음.
# 통신: Compose 네트워크 안에서는 localhost 금지. 아래 Compose 서비스명 사용.
#
# FastAPI 호출 주소(Spring 설정):
#   앱 코드에서 baseUrl + "/ai/v1/internal/..." 를 조합함.
#   AI_SERVER_BASE_URL 은 「스킴 + 호스트 + 포트」(경로 포함 금지) 만 지정.
#   예: AI_SERVER_BASE_URL=http://ai-server:8001
#   ❌ 하지 않음: .../ai/v1/internal — Chroma 는 8000 고정이라 ai-server 포트와 혼동 주의.
#
# Spring / ai-server 의 APP 포트 등은 같은 env 로드 후에도 `docker-compose.prod.yml` 의 environment 로 구분 설정함.
# =============================================================================

# --- Compose 변수 (Compose 가 직접 substitution 할 수 있음) ---
IMAGE_TAG=local
APP_ENV=prod
SPRING_PROFILES_ACTIVE=prod
# 게이트웨이 HTTPS(Compose 기본: 443만 publish). Let's Encrypt HTTP-01 등 필요 시 아래 선택 + compose 주석 해제.
NGINX_PUBLISH_HTTPS_PORT=443
# NGINX_PUBLISH_HTTP_PORT=80

# Nginx TLS: 호스트 디렉터리를 컨테이너 /etc/nginx/ssl 로 read-only bind(fullchain.pem, privkey.pem). Git에 PEM 커밋 금지.
# Self-hosted 런타임 예: C:/industrial-ai-runtime/nginx/ssl | 로컬 리포만 쓸 때: ./nginx/ssl
NGINX_SSL_DIR=C:/industrial-ai-runtime/nginx/ssl

# 컨테이너 간 충돌 방지 포트 이름 (두 서비스가 동일 env_file 로드 시 Compose 가 오버라이드)
SPRING_APP_PORT=8080
FASTAPI_APP_PORT=8001
SPRING_APP_NAME=factory-guard-api
AI_SERVICE_APP_NAME=industrial-ai-server
SPRING_INSTANCE_ID=spring-docker-1
AI_SERVER_LISTEN_HOST=0.0.0.0

# --- Frontend 빌드 (Vite, 이미지 build 시점에만 적용) ---
VITE_APP_NAME=Industrial AI Platform
VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=

# --- MariaDB (compose mariadb 초기화 + Spring 연결) ---
MARIADB_HOST=mariadb
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=industrial_ai
MARIADB_USER=industrial_user
MARIADB_PASSWORD=

DB_HOST=mariadb
DB_PORT=3307
DB_NAME=industrial_ai
DB_USER=industrial_user
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_INSPECTION_ARTIFACTS=inspection-artifacts
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_MODELS=models
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKETS=true

# --- Chroma ---
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION_DOCUMENTS=industrial_document_chunks
CHROMA_HEALTH_TIMEOUT_MS=3000

# --- Spring → FastAPI + 운영 옵션 (Spring 과 FastAPI 로그/동작 설정 겸용) ---
AI_SERVER_BASE_URL=http://ai-server:8001
AI_SERVER_STATUS_PATH=/ai/v1/internal/system-status
AI_SERVER_STATUS_TIMEOUT_SEC=3
AI_REQUEST_TIMEOUT_SECONDS=180

# Spring: app.cors.allowed-origin-patterns (APP_CORS_ALLOWED_ORIGINS 이름은 사용하지 않음)
# 운영 공개 도메인(브라우저 Origin 과 정확히 일치). 로컬 prod 스모크가 필요하면 콤마로 추가: ,https://localhost
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://industrial-ai.ddns.net

MAX_ACTIVE_USERS=100
ACTIVE_SESSION_TTL_SECONDS=1800

AI_JOB_WORKER_ENABLED=true
AI_JOB_WORKER_CONCURRENCY=1
AI_JOB_POLL_INTERVAL_MS=1000
AI_JOB_BATCH_SIZE=1
AI_JOB_MAX_RETRY=0

MODEL_MEMORY_BANK_MIN_NORMAL_IMAGE_COUNT=10
MODEL_SPEED_OBJECT_CKPT_KEY=models/base/speed-object/model.ckpt
MODEL_SPEED_OBJECT_CONFIG_KEY=models/base/speed-object/config.json
MODEL_SPEED_TEXTURE_CKPT_KEY=models/base/speed-texture/model.ckpt
MODEL_SPEED_TEXTURE_CONFIG_KEY=models/base/speed-texture/config.json
MODEL_PERFORMANCE_OBJECT_CKPT_KEY=models/base/performance-object/model.ckpt
MODEL_PERFORMANCE_OBJECT_CONFIG_KEY=models/base/performance-object/config.json
MODEL_PERFORMANCE_TEXTURE_CKPT_KEY=models/base/performance-texture/model.ckpt
MODEL_PERFORMANCE_TEXTURE_CONFIG_KEY=models/base/performance-texture/config.json

OPERATION_MONITORING_COLLECT_INTERVAL_MS=30000
OPERATION_MONITORING_REDIS_TTL_SECONDS=60

DOCUMENT_UPLOAD_MAX_SIZE_BYTES=52428800
DOCUMENT_UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,md
DOCUMENT_UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown,text/plain
DOCUMENT_UPLOAD_OBJECT_PREFIX=documents

JWT_SECRET=
JWT_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- FastAPI (같은 .env 로드 시 MinIO/Chroma/redis 와 이름 일치 필요) ---
API_PREFIX=/api/v1
LOG_LEVEL=INFO
TZ=Asia/Seoul
MINIO_ENABLED=true
RETRIEVER_TYPE=chroma
RAG_ENABLED=true
LANGGRAPH_ENABLED=true

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL_NAME=qwen2.5:3b

REDIS_ENABLED=true
REDIS_DB=0

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

INTERNAL_API_KEY=
SPRING_INTEGRATION_ENABLED=false
SPRING_API_BASE_URL=http://spring:8080
