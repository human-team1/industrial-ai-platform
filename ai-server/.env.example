# ==================================================
# Runtime
# ==================================================
APP_ENV=local
RUN_OWNER=A_OR_B
STAGE=local
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8005
API_PREFIX=/api/v1

# ==================================================
# Experiment
# ==================================================
EXPERIMENT_NAME=rag_langgraph_3day_eval
EXPERIMENT_ROOT=./experiments/rag_langgraph_eval
CORPUS_DIR=./experiments/rag_langgraph_eval/corpus
DATASET_DIR=./experiments/rag_langgraph_eval/datasets
RESULT_DIR=./experiments/rag_langgraph_eval/results

# ==================================================
# Chroma
# ==================================================
CHROMA_HOST=localhost
CHROMA_PORT=8003
CHROMA_PERSIST_DIR=./experiments/rag_langgraph_eval/chroma_store
CHROMA_COLLECTION_NAME=industrial_rag_chunks_a_v1
CHROMA_COLLECTION_DOCUMENTS=industrial_rag_chunks_a_v1
CHROMA_COLLECTION_SUFFIX=dev
CHROMA_METADATA_ORG_KEY=organization_id
CHROMA_METADATA_DOCUMENT_STATUS_KEY=document_status
CHROMA_METADATA_DOCUMENT_VERSION_KEY=document_version_id
CHROMA_ALLOWED_DOCUMENT_STATUS=PUBLISHED

# ==================================================
# RAG
# ==================================================
RAG_ENABLED=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SEARCH_TYPE=hybrid
RAG_RERANKER_ENABLED=false
RAG_MIN_SCORE=0.4
RAG_REQUIRE_SOURCE=true
RAG_SOURCE_REQUIRED=true
RAG_NO_RESULT_ANSWER_ENABLED=false
RAG_ORGANIZATION_FILTER_REQUIRED=true
RAG_DOCUMENT_STATUS_FILTER_REQUIRED=true
RAG_DEFAULT_ORGANIZATION_ID=1
RAG_DEFAULT_DOCUMENT_STATUS=PUBLISHED
RAG_SOURCE_FIELDS=document_id,document_version_id,chunk_id,title,section_title,page,content,score,rank,source_uri

# ==================================================
# Retrieval Best Config
# ==================================================
RETRIEVAL_CONFIG_ID=R3_HYBRID_TK10_S04
RETRIEVAL_FROZEN_AT=2026-04-30
RETRIEVAL_INTERNAL_TOP_K=10
RETRIEVAL_ANSWER_TOP_K=5
RETRIEVAL_VISIBLE_SOURCE_LIMIT=3
RETRIEVAL_DEDUPLICATE_BY_DOCUMENT=true
RETRIEVAL_DIVERSIFY_BY_SECTION=true
RETRIEVAL_MMR_ENABLED=false

# ==================================================
# LangGraph
# ==================================================
LANGGRAPH_ENABLED=true
LANGGRAPH_WORKFLOW_NAME=inspection_rag_graph_v0
LANGGRAPH_VERSION=graph_v0
LANGGRAPH_STATE_CHECKPOINT_ENABLED=false
LANGGRAPH_SESSION_STORE=memory

QUERY_ROUTER_ENABLED=true
QUERY_MODE_AUTO_DETECT=true
QUERY_MODE_RESULT_LINKED=result_linked
QUERY_MODE_DOCUMENT_SEARCH=document_search
QUERY_MODE_GENERAL=general
QUERY_MODE_OUT_OF_SCOPE=out_of_scope

RESULT_LINKED_REQUIRED_KEYS=result_id,user_id,organization_id
RESULT_CONTEXT_RESOLUTION_ENABLED=false
RESULT_CONTEXT_SOURCE=mock
RESULT_CONTEXT_SAMPLE_PATH=./experiments/rag_langgraph_eval/datasets/result_context_samples_v1.json

DOCUMENT_RETRIEVAL_AUTO_DECIDE=true
DOCUMENT_SEARCH_KEYWORDS=매뉴얼,점검,조치,설비,오류,고장,원인,체크리스트,장력,정렬,조명,카메라,heatmap,anomaly,map,score
SERVICE_SCOPE_CHECK_ENABLED=true
SERVICE_SCOPE_KEYWORDS=이상탐지,검사결과,설비점검,문서검색,조치방법,재검사,불량,정상,anomaly,manual,heatmap,score,threshold

# ==================================================
# LLM / Embedding
# ==================================================
LLM_PROVIDER=ollama
LLM_MODEL_NAME=gemma:2b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=120
LLM_STREAMING=false

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_CACHE_DIR=./experiments/rag_langgraph_eval/results/embedding_eval/cache/huggingface
EMBEDDING_LOCAL_FILES_ONLY=true
GEMINI_API_KEY=

# ==================================================
# Prompt / Answer Policy
# ==================================================
ANSWER_LANGUAGE=ko
ANSWER_FORMAT=industrial_action_guide
RESULT_LINKED_ANSWER_SECTIONS=가능한 원인,확인 항목,조치 순서,재검사 조건,참고 출처
DOCUMENT_SEARCH_ANSWER_SECTIONS=요약,점검 기준,조치 방법,주의사항,참고 출처
GENERAL_ANSWER_MODE=service_guide_only
NO_RETRIEVAL_RESULT_MESSAGE=관련 문서를 찾지 못했습니다. 설비명, 증상, 오류 메시지, 검사 결과를 포함해 다시 질문해주세요.
OUT_OF_SCOPE_MESSAGE=이 서비스는 산업 이상탐지 결과, 설비 점검, 문서 검색, 대응 절차 안내 범위의 질문만 지원합니다.

# ==================================================
# Input Validation
# ==================================================
QUESTION_MIN_LENGTH=2
QUESTION_MAX_LENGTH=1000
BLOCK_PROMPT_INJECTION_ENABLED=true
BLOCK_HTML_SCRIPT_INPUT=true

# ==================================================
# FastAPI Internal RAG API
# ==================================================
RAG_API_ENABLED=true
RAG_API_PATH=/api/v1/rag/query
INTERNAL_API_KEY=

# ==================================================
# Spring Contract Only
# ==================================================
SPRING_INTEGRATION_ENABLED=false
SPRING_API_BASE_URL=http://localhost:8080
SPRING_INTERNAL_API_TIMEOUT_SECONDS=5

# ==================================================
# MinIO
# ==================================================
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=industrial-ai-files
MINIO_SECURE=false

# ==================================================
# Redis
# ==================================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# ==================================================
# LangSmith
# ==================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=industrial-rag-eval
LANGSMITH_TRACE_USER_CONTEXT=true
LANGSMITH_TRACE_RETRIEVED_CHUNKS=true
LANGSMITH_TRACE_PROMPT=true
LANGSMITH_TRACE_SOURCES=true
LANGSMITH_TRACE_GRAPH_STATE=true
